rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // Helper Functions
    // ─────────────────────────────────────────────

    /** Returns true if the request is authenticated via Firebase Auth. */
    function isAuthenticated() {
      return request.auth != null;
    }

    /**
     * Returns true only if the authenticated user's UID corresponds to a
     * document in the read-only `admins` collection.
     *
     * CRITICAL: The `admins` collection is NEVER writable from the web app.
     * It can only be modified directly via the Firebase Console / Admin SDK.
     */
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    /**
     * Returns true if the authenticated user is a SUPER_ADMIN.
     * Reads the `role` field from the admin's Firestore document.
     */
    function isSuperAdmin() {
      return isAdmin() &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'SUPER_ADMIN';
    }

    // ─────────────────────────────────────────────
    // ADMINS collection — STRICTLY READ-ONLY from the app
    // ─────────────────────────────────────────────
    // Each admin document uses the Firebase Auth UID as the document ID.
    // The app reads ONLY the authenticated user's own record to verify access.
    // WRITE is permanently blocked from all clients.
    match /admins/{adminId} {
      // Allow any admin to read ALL admin profiles (needed for SUPER_ADMIN trip assignment UI).
      allow read: if isAdmin();
      // Allow an admin to update ONLY their own fcmToken
      allow update: if request.auth.uid == adminId 
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken']);
      allow create, delete: if false;
    }

    // ─────────────────────────────────────────────
    // RBAC Helpers
    // ─────────────────────────────────────────────

    /**
     * True if the current user's UID is in the resource's `adminIds` array,
     * OR if the current user is a SUPER_ADMIN (can manage any resource).
     */
    function isResourceAdmin() {
      return isSuperAdmin() || (
        isAdmin() && (
          (resource != null && request.auth.uid in resource.data.adminIds) ||
          (resource == null && request.resource != null && request.auth.uid in request.resource.data.adminIds)
        )
      );
    }

    // ─────────────────────────────────────────────
    // TOURS collection
    // ─────────────────────────────────────────────
    match /tours/{tourId} {
      allow read: if isAdmin();
      // Only SUPER_ADMINs can create tours.
      allow create: if isSuperAdmin();
      // Updates can be done by assigned admins or SUPER_ADMINs
      allow update: if isResourceAdmin();
      // Deletes ONLY by SUPER_ADMINs
      allow delete: if isSuperAdmin();
    }

    // ─────────────────────────────────────────────
    // TRIPS collection
    // ─────────────────────────────────────────────
    // Public read: coordinators need to browse trips for candidacy
    // Admin write: only verified admins can mutate trip data
    match /trips/{tripId} {
      allow read: if isResourceAdmin() || resource.data.coordinatorId == null;
      // SUPER_ADMINs can create any trip.
      // Standard admins can create trips where they are in adminIds.
      allow create: if isSuperAdmin() || (
        isAdmin() && request.auth.uid in request.resource.data.adminIds
      );
      allow update: if isResourceAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─────────────────────────────────────────────
    // HOTELS collection
    // ─────────────────────────────────────────────
    // Full admin access only
    match /hotels/{hotelId} {
      allow read: if isAdmin();
      allow create: if isSuperAdmin() || (
        isAdmin() && request.auth.uid in request.resource.data.adminIds
      );
      allow update: if isResourceAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─────────────────────────────────────────────
    // COORDINATORS collection
    // ─────────────────────────────────────────────
    // Public: anyone can create (candidacy form)
    // Admin: full access to read/update, delete restricted
    match /coordinators/{coordinatorId} {
      allow read: if isAdmin();
      allow create: if true; // Public candidacy form
      allow update: if isAdmin(); // Upsert handled by service logic
      allow delete: if isSuperAdmin();
    }

    // ─────────────────────────────────────────────
    // CANDIDACIES collection
    // ─────────────────────────────────────────────
    // Public can create candidacies (the public-facing application form)
    // Admins manage all candidacies
    match /candidacies/{candidacyId} {
      allow create: if true; // Public candidacy submission
      allow read, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─────────────────────────────────────────────
    // TRIP ASSIGNMENTS sub-collection
    // ─────────────────────────────────────────────
    match /trips/{tripId}/assignments/{assignmentId} {
      allow read, create, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // Default: deny everything not explicitly covered above
    // ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
